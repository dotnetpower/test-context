[Unit]
Description=Shared local Rust incremental pytest dependency graph and background test cache
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/tctx daemon
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=TCTX_IDLE_TIMEOUT_SECS=7200
Environment=TCTX_LARGE_ROOT_IDLE_TIMEOUT_SECS=3600
Environment=TCTX_MAX_RSS_MB=2560
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TasksMax=2048
LimitNOFILE=16384
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
CPUWeight=100
IOAccounting=yes
IOWeight=100

[Install]
WantedBy=default.target
